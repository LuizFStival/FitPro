rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId);

      function isValidUser(data) {
        return (data.get('userId', request.auth.uid) == request.auth.uid) &&
               (data.get('email', '') is string);
      }

      // Workouts Subcollection
      match /workouts/{workoutId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWorkout(request.resource.data);
        allow delete: if isOwner(userId);

        function isValidWorkout(data) {
          return (data.get('userId', userId) == userId) &&
                 (data.get('id', workoutId) is string) &&
                 (data.startTime is string || data.startTime is timestamp) &&
                 (data.exercises is list);
        }
      }

      // Insights Subcollection
      match /insights/{insightId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}

